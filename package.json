{
  "name": "visualflow-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VisualFlow Studio - All-in-One Visual Document, Presentation, Diagram & Chart Creation Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @visualflow/api --filter @visualflow/web dev",
    "dev:web": "pnpm --filter @visualflow/web dev",
    "dev:api": "pnpm --filter @visualflow/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "prettier": "^3.5.0"
  }
}
